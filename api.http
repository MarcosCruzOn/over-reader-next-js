# ==========================================
# 1. AUTENTICAÇÃO E USUÁRIOS
# ==========================================

### Cadastrar um novo Usuário (Admin)
POST {{baseUrl}}/users
Content-Type: application/json

{
  "name": "Leitor Assíduo",
  "email": "leitorAdmin@overreader.com",
  "password": "senha_segura@123",
  "role": "ADMIN"
}

### Fazer Login
POST {{baseUrl}}/auth/login
Content-Type: application/json

{
  "email": "leitorAdmin@overreader.com",
  "password": "senha_segura@123"
}

### Listar todos os usuários
GET {{baseUrl}}/users
Authorization: Bearer {{token}}

### Banir ou suspender um usuário
# Mude o ID na URL para o usuário que deseja alterar
PATCH {{baseUrl}}/users/2/status
Content-Type: application/json
Authorization: Bearer {{token}}

{
  "status": "ATIVO"
}

### Atualizar Foto de Perfil (Upload para AWS S3)
PATCH {{baseUrl}}/users/1/avatar
Authorization: Bearer {{token}}
Content-Type: multipart/form-data; boundary=----BoundaryParaUploadDaImagem

------BoundaryParaUploadDaImagem
Content-Disposition: form-data; name="avatar"; filename="teste.jpg"
Content-Type: image/jpeg

< ./teste.jpg
------BoundaryParaUploadDaImagem--


# ==========================================
# 2. MANGÁS
# ==========================================

### Listar Todos os Mangás (Público)
GET {{baseUrl}}/mangas

### Criar Mangá (Requer Token de Admin)
POST {{baseUrl}}/mangas
Content-Type: application/json
Authorization: Bearer {{token}}

{
  "title": "Solo Leveling",
  "author": "Chugong",
  "genres": "Ação, Fantasia, Shonen",
  "synopsis": "Dez anos atrás, O Portão conectou o mundo real com o reino da magia e monstros...",
  "status": "andamento",
  "releaseYear": 2018,
  "publisher": "D&C Media"
}

### Atualizar Mangá (Ex: mudar o status)
PUT {{baseUrl}}/mangas/1
Content-Type: application/json
Authorization: Bearer {{token}}

{
  "status": "Em andamento"
}

### Deletar Mangá
DELETE {{baseUrl}}/mangas/1
Authorization: Bearer {{token}}

### Atualizar A capa do Mangá (Upload para AWS S3)
PATCH {{baseUrl}}/mangas/1/cover
Authorization: Bearer {{token}}
Content-Type: multipart/form-data; boundary=----BoundaryParaUploadDaImagem

------BoundaryParaUploadDaImagem
Content-Disposition: form-data; name="cover"; filename="NarutoVolume1.jpg"
Content-Type: image/jpeg

< ./NarutoVolume1.jpg
------BoundaryParaUploadDaImagem--


# ==========================================
# 3. VOLUMES E CAPÍTULOS
# ==========================================

### Criar Volume 1 para o Mangá 1
POST {{baseUrl}}/volumes
Content-Type: application/json
Authorization: Bearer {{token}}

{
  "mangaId": 1,
  "volumeNumber": 1,
  "title": "O Despertar"
}

### Criar Capítulo 1 no Volume 1
POST {{baseUrl}}/chapters
Content-Type: application/json
Authorization: Bearer {{token}}

{
  "volumeId": 1,
  "chapterNumber": 1,
  "title": "O Início de Tudo",
  "pages": ["https://link-da-pagina-1.jpg", "https://link-da-pagina-2.jpg"]
}


# ==========================================
# 4. INTERAÇÕES E AVALIAÇÕES
# ==========================================

### Avaliar um Mangá (1 a 5 estrelas)
POST {{baseUrl}}/reviews
Content-Type: application/json
Authorization: Bearer {{token}}

{
  "userId": 1,
  "mangaId": 1,
  "rating": 5
}

### Favoritar um Mangá
POST {{baseUrl}}/favorites
Content-Type: application/json
Authorization: Bearer {{token}}

{
  "userId": 1,
  "mangaId": 1
}

### Comentar em um Mangá
POST {{baseUrl}}/comments
Content-Type: application/json
Authorization: Bearer {{token}}

{
  "userId": 1,
  "mangaId": 1,
  "content": "Arte simplesmente incrível! Ansioso pelo próximo capítulo."
}